{
  "class_name" : "table",
  "blend_path" : "./ShapeProgramsDataset/table.blend",
  "params" : {
    "Base": {
      "type": "nested",
      "params": {
        "Width": {
          "type": "float",
          "range": [
            0.3,
            4.0
          ]
        },
        "Height": {
          "type": "float",
          "range": [
            0.3,
            1.3
          ]
        },
        "Depth": {
          "type": "float",
          "range": [
            0.3,
            1.5
          ]
        }
      }
    },
    "Top": {
      "type": "nested",
      "params": {
        "Top Shape": {
         "type": "int",
            "range": [
              0,
              2
            ]
        },
        "Top Thickness": {
            "type": "float",
            "range": [
              0.01,
              0.1
            ]
          }
      }
    },
    "Legs": {
      "type": "nested",
      "params": {
        "Legs Type": {
          "type": "int",
          "range": [
            0,
            2
          ]
        },
        "Legs Type": {
          "type": "int",
          "range": [
            0,
            2
          ]
        },
        "Has Cabinet Leg": {
          "type": "bool",
          "range": [
            0,
            2
          ],
          "or_dependencies": [["Legs Type", 1]]
        },
        "Cabinet Width Scale": {
          "type": "float",
          "range": [
            0.3,
            0.5
          ],
          "or_dependencies": [["Legs Type", 1], "Has Cabinet Leg"]
        },
        "Legs Scale X": {
          "type": "float",
          "range": [
            0.01,
            0.1
          ],
          "or_dependencies": [["Legs Type", 1]]
        },
        "Legs Scale Y": {
          "type": "float",
          "range": [
            0.01,
            0.5
          ],
          "or_dependencies": [["Legs Type", 1]]
        },
        "Legs Offset X": {
          "type": "float",
          "range": [
            0.0,
            1.0
          ],
          "or_dependencies": [["Legs Type", 1]]
        },
        "Legs Offset Y": {
          "type": "float",
          "range": [
            0.0,
            1.0
          ],
          "or_dependencies": [["Legs Type", 1]]
        },
        "Mid Leg X Scale": {
              "type": "float",
              "range": [
                  0.05,
                  0.5
              ],
              "or_dependencies": [["Legs Type", 0]]
              },
        "Mid Leg Y Scale": {
            "type": "float",
            "range": [
                0.05,
                0.5
            ],
            "or_dependencies": [["Legs Type", 0]]
        }
      }
    },
    "Mid Board": {
      "type": "nested",
      "params": {
        "Has Mid Board": {
         "type": "bool",
          "or_dependencies": [["Legs Type", 1]]
        },
        "Mid Board Z Scale": {
            "type": "float",
            "range": [
                0.00,
                0.5
            ],
            "or_dependencies": ["Has Mid Board"]
        }
      }
    }
  }
}